{
    "format_version": "1.26.50",
    "minecraft:block": {
        "description": {
            "identifier": "starstone:generator",
            "menu_category": {
                "category": "items"
            },
            "states": {
                "starstone:enabled": [
                    true,
                    false
                ]
            }
        },
        "components": {
            "minecraft:tags": ["minecraft:is_pickaxe_item_destructible"],
            "minecraft:flammable": false,
            "minecraft:destructible_by_explosion": {"explosion_resistance": 6},
            "minecraft:liquid_detection": {"detection_rules": [{"liquid_type": "water", "can_contain_liquid": false, "on_liquid_touches": "blocking"}]},
            "starstone:piston_support": {},
            "minecraft:map_color": [
                30,
                40,
                60
            ],
            "minecraft:destructible_by_mining": {
              "seconds_to_destroy": 5
            },
            "minecraft:loot": "loot_tables/blocks/generator.json",
            "minecraft:geometry": "minecraft:geometry.full_block",
            "minecraft:redstone_conductivity": { "redstone_conductor": true },
            "minecraft:material_instances": {
                "*": {
                    "texture": "starstone:generator_off",
                    "face_dimming": false,
                    "ambient_occlusion": 0
                }
            },
            "starstone:generator": {},
            "minecraft:movable": {
                "movement_type": "push_pull"
            },
            "minecraft:light_emission": 0
        },
        "permutations": [
            {
                "condition": "query.block_state('starstone:enabled') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:generator",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 1
                }
            }
        ]
    }
}
