{
    "format_version": "1.26.50",
    "minecraft:block": {
        "description": {
            "identifier": "starstone:conduit",
            "menu_category": {
                "category": "items"
            },
            "states": {
                "starstone:axis": [
                    "x",
                    "y",
                    "z"
                ],
                "starstone:powered": [
                    false,
                    true
                ]
            }
        },
        "components": {
            "minecraft:light_dampening": 15,
            "minecraft:redstone_conductivity": {"redstone_conductor": true},
            "minecraft:tags": ["minecraft:is_pickaxe_item_destructible"],
            "minecraft:flammable": false,
            "minecraft:destructible_by_explosion": {"explosion_resistance": 6},
            "minecraft:liquid_detection": {"detection_rules": [{"liquid_type": "water", "can_contain_liquid": false, "on_liquid_touches": "blocking"}]},
            "starstone:piston_support": {},
            "minecraft:tick": { "interval_range": [2, 2], "looping": true },
            "starstone:conduit": {},
            "minecraft:map_color": [
                30,
                40,
                60
            ],
            "minecraft:destructible_by_mining": {
              "seconds_to_destroy": 5
            },
            "minecraft:loot": "loot_tables/blocks/conduit.json",
            "minecraft:geometry": {
                "identifier": "geometry.starstone_conduit"
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "starstone:casing",
                    "face_dimming": false,
                    "ambient_occlusion": 0
                }
            },
            "minecraft:movable": {
                "movement_type": "push_pull"
            },
            "minecraft:light_emission": 0
        },
        "permutations": [
            {
                "condition": "query.block_state('starstone:axis') == 'x' && query.block_state('starstone:powered') == false",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "east": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "west": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 0
                }
            },
            {
                "condition": "query.block_state('starstone:axis') == 'x' && query.block_state('starstone:powered') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "east": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "west": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 1
                }
            },
            {
                "condition": "query.block_state('starstone:axis') == 'y' && query.block_state('starstone:powered') == false",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "up": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "down": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 0
                }
            },
            {
                "condition": "query.block_state('starstone:axis') == 'y' && query.block_state('starstone:powered') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "up": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "down": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 1
                }
            },
            {
                "condition": "query.block_state('starstone:axis') == 'z' && query.block_state('starstone:powered') == false",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "north": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "south": {
                            "texture": "starstone:conduit_end_off",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 0
                }
            },
            {
                "condition": "query.block_state('starstone:axis') == 'z' && query.block_state('starstone:powered') == true",
                "components": {
                    "minecraft:material_instances": {
                        "*": {
                            "texture": "starstone:casing",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "north": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        },
                        "south": {
                            "texture": "starstone:conduit_end",
                            "face_dimming": false,
                            "ambient_occlusion": 0
                        }
                    },
                    "minecraft:light_emission": 1
                }
            }
        ]
    }
}
